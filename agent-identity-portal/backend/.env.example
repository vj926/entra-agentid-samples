# === Mode Toggle ===
PROVISIONING_MODE=mock  # "mock" or "live"

# === Local-dev only (NEVER set in production) ===
# When AZURE_TENANT_ID is blank AND this is true, the API skips token validation
# and treats every caller as an approver. Used only for offline demos.
DEV_AUTH_BYPASS=false
# Seed fake blueprints / requests on first startup (for demos).
SEED_DEMO_DATA=false
# Expose /docs, /redoc, /openapi.json. Off by default.
ENABLE_DOCS=false

# === Entra ID / MSAL ===
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-backend-app-client-id
FRONTEND_CLIENT_ID=your-spa-client-id

# === Backend -> Graph credential (pick ONE) ===
# Listed in order of preference. The first one configured wins.
#
# 1) Managed Identity (RECOMMENDED when running in Azure - App Service,
#    Container Apps, AKS, VM, etc. No secrets on disk.)
USE_MANAGED_IDENTITY=false
# Optional: user-assigned MI client ID. Leave blank for system-assigned.
MANAGED_IDENTITY_CLIENT_ID=

# 2) Certificate auth (RECOMMENDED for non-Azure hosts).
#    Upload the corresponding public cert to the app registration.
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_THUMBPRINT=

# 3) Client secret (LEAST PREFERRED).
#    Prefer a Key Vault reference so the secret is never on disk:
AZURE_CLIENT_SECRET_KEYVAULT_URI=
#    ...or inline for local dev only:
AZURE_CLIENT_SECRET=

# === Microsoft Graph (for live provisioning) ===
GRAPH_SCOPE=https://graph.microsoft.com/.default

# === Email Notifications (optional) ===
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=your-smtp-password
APPROVAL_LINK_BASE_URL=http://localhost:3000

# === Teams Notifications (optional) ===
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...

# === Database ===
DATABASE_URL=sqlite:///./agent_portal.db

# === CORS (comma-separated list) ===
FRONTEND_ORIGIN=http://localhost:3000
