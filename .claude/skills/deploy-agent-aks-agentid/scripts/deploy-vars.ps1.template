# Copy to your working directory, fill in values, then dot-source:
#   . .\deploy-vars.ps1
# Or set $env:VARS_FILE to the path and let deploy-aks-dev.ps1 dot-source it.
#
# Scripts in this skill append newly-discovered IDs (OIDC_ISSUER, APP_FQDN) back
# to this file as they run. Re-dot-source after each step that prints "appended:".

# ============================================================================
#  Entra tenant — where the Blueprint, Agent Identity, and Client SPA live.
#  This is the tenant whose admin ran Start-EntraAgentIDWorkflow.
# ============================================================================
$env:TENANT_ID = ""

# ============================================================================
#  Azure subscription tenant — where the AKS cluster, ACR, and RG live.
#  OPTIONAL: defaults to $env:TENANT_ID for single-tenant deployments.
#  Set only when the Azure sub lives in a DIFFERENT tenant than the Blueprint
#  (cross-tenant federation — see references/cross-tenant-federation.md).
# ============================================================================
if (-not $env:SUBSCRIPTION_TENANT_ID) { $env:SUBSCRIPTION_TENANT_ID = $env:TENANT_ID }

# ============================================================================
#  Azure subscription / location / RG
# ============================================================================
$env:SUBSCRIPTION_ID = ""
$env:RG              = "rg-agentid-aks-dev"
$env:LOCATION        = "eastus2"    # any region with AKS + ACR + your VM SKU available

# ============================================================================
#  AKS + ACR
# ============================================================================
$env:AKS_NAME = "aks-agentid-dev"

# ACR name: 5–50 chars, lowercase alphanumeric, GLOBALLY unique. Suggestion:
#   $env:ACR_NAME = "acragentid" + (Get-Random -Minimum 1000 -Maximum 9999)
# Compute ONCE, paste the result here. Do NOT call Get-Random inline — every
# dot-source re-evaluates the file and would drift the suffix between steps.
$env:ACR_NAME = ""

# ACR SKU: Basic (~$5/mo, 10 GB) | Standard (~$20/mo, 100 GB) | Premium (geo-replication)
$env:ACR_SKU = "Basic"

# Node pool. See references/sku-sizing.md for the full matrix.
#   Standard_B2s        (2 vCPU /  4 GB, ~$30/mo)  — minimum; qwen2.5:1.5b only, slow
#   Standard_D2s_v5     (2 vCPU /  8 GB, ~$70/mo)  — comfortable for qwen2.5:1.5b
#   Standard_D4s_v5     (4 vCPU / 16 GB, ~$140/mo) — required for qwen2.5:7b on CPU
#   Standard_NC4as_T4_v3 (4 vCPU/28 GB + T4 GPU, ~$540/mo) — qwen2.5:7b at usable latency
$env:NODE_VM_SIZE = "Standard_D4s_v5"
$env:NODE_COUNT   = "2"

# ============================================================================
#  Storage (PVC for Ollama models)
# ============================================================================
# At least model_disk × 2. 20 GiB covers any single 7B model with room for one
# alternate. Disk grows as you pull more models; never shrinks.
$env:STORAGE_GB = "20"

# ============================================================================
#  Ingress
# ============================================================================
# LoadBalancer (default — public Standard LB, ~$18/mo, plain HTTP)
# ingress-nginx (install Helm chart + cert-manager for TLS)
# appgw         (AKS Application Gateway add-on; managed TLS, +$240/mo base)
$env:INGRESS_TYPE = "LoadBalancer"

# ============================================================================
#  Logs
# ============================================================================
# none                                — kubectl logs only; free; lost on pod delete
# azure-monitor-container-insights    — retained logs; ~$2-3/GB ingested
$env:ENABLE_LOGS = "none"

# ============================================================================
#  Entra Agent ID objects — populated by entra-agent-id-setup (Step 1)
# ============================================================================
$env:BLUEPRINT_APP_ID   = ""
$env:AGENT_CLIENT_ID    = ""
$env:CLIENT_SPA_APP_ID  = ""       # OPTIONAL: only set for user-OBO mode

# Only needed for the `kind` local smoke test (which uses ClientSecret instead
# of Workload Identity). The AKS deployment path never uses this.
$env:BLUEPRINT_CLIENT_SECRET = ""

# ============================================================================
#  Ollama (only used by sample agent — ignore if bringing your own agent)
# ============================================================================
# qwen2.5:0.5b   ~700 MB  — fastest, tool-calling unreliable
# qwen2.5:1.5b   ~1.3 GB  — DEFAULT; best demo-quality on CPU
# qwen2.5:3b     ~2.0 GB  — needs D4s+
# qwen2.5:7b     ~4.3 GB  — needs D4s+ on CPU, GPU node for usable latency
# llama3.2:1b    ~1.3 GB  — alternate small model
$env:OLLAMA_MODEL = "qwen2.5:1.5b"

# ============================================================================
#  FIC naming — only customize when redeploying onto a cluster whose previous
#  FIC name is still on the Blueprint. Default `aks-agent-sa` is fine for
#  first-time deploys.
# ============================================================================
if (-not $env:FIC_NAME) { $env:FIC_NAME = "aks-agent-sa" }

# ============================================================================
#  Auto-filled by scripts — do not edit by hand
# ============================================================================
$env:OIDC_ISSUER = ""              # filled by 01-create-aks.ps1
$env:APP_FQDN    = ""              # filled by 04-apply-manifests.ps1 (= LB IP)
